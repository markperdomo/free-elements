{
  "name": "free-elements",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Free, open-source PowerPoint tools for Mac: align, space, resize, and format slides with a compact native palette.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/markperdomo/free-elements.git" },
  "homepage": "https://github.com/markperdomo/free-elements#readme",
  "bugs": { "url": "https://github.com/markperdomo/free-elements/issues" },
  "keywords": ["powerpoint", "macos", "presentation", "alignment", "vba", "swift", "office-addin"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "start:office": "node scripts/serve.mjs --https",
    "test": "node --test tests/*.test.mjs",
    "cert": "node scripts/certificate.mjs",
    "sideload": "node scripts/sideload.mjs",
    "host:test": "python3 scripts/create-host-test.py",
    "build:native": "python3 scripts/build-native.py",
    "build:distribution": "python3 scripts/build-native.py --distribution --output-dir dist/distribution",
    "package:installer": "python3 scripts/package-installer.py",
    "package:source": "python3 scripts/package-source.py",
    "package:native": "python3 scripts/package-native.py",
    "install:native": "python3 scripts/install-native.py",
    "test:native-package": "python3 -m unittest discover -s native/tests -p 'test_*.py'"
  }
}
